# Optional Hugging Face write token. Used only when a command includes --push.
HF_TOKEN=

# Set these to the owning host user's numeric IDs for bind-mount write access.
HOST_UID=1000
HOST_GID=1000

# Optional absolute host path outside the source checkout; defaults to ../osm-polygon-data.
# OSM_POLYGON_DATA_ROOT=/absolute/path/to/osm-polygon-data
